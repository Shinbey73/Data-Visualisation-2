{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "State versus food-related price pressure heatmap",
    "subtitle": "Year-on-year inflation by Malaysian state and selected Consumer Price Index divisions",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555"
  },
  "width": 960,
  "height": 520,
  "data": {
    "url": "data/cpi_state_division_heatmap_clean.csv"
  },
  "params": [
    {
      "name": "selected_year",
      "value": 2026,
      "bind": {
        "input": "select",
        "options": [
          2011,
          2012,
          2013,
          2014,
          2015,
          2016,
          2017,
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024,
          2025,
          2026
        ],
        "name": "Year: "
      }
    },
    {
      "name": "selected_month",
      "value": "March",
      "bind": {
        "input": "select",
        "options": [
          "January",
          "February",
          "March",
          "April",
          "May",
          "June",
          "July",
          "August",
          "September",
          "October",
          "November",
          "December"
        ],
        "name": "Month: "
      }
    },
    {
      "name": "division_view",
      "value": "Food-related pressure channels",
      "bind": {
        "input": "select",
        "options": [
          "Food-related pressure channels",
          "All main divisions"
        ],
        "name": "Division view: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year == selected_year && datum.month == selected_month"
    },
    {
      "filter": "division_view == 'All main divisions' || datum.division_scope == 'Food-related pressure channels'"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "inflation_yoy",
          "as": "average_state_inflation"
        }
      ],
      "groupby": [
        "state_display"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "inflation_yoy",
          "as": "highest_cell_inflation"
        },
        {
          "op": "min",
          "field": "inflation_yoy",
          "as": "lowest_cell_inflation"
        }
      ]
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 0.8
  },
  "encoding": {
    "x": {
      "field": "division_label",
      "type": "nominal",
      "title": "Consumer Price Index main division",
      "sort": {
        "field": "division_order",
        "order": "ascending"
      },
      "axis": {
        "labelAngle": -35,
        "labelAlign": "right",
        "labelLimit": 210,
        "titlePadding": 20
      }
    },
    "y": {
      "field": "state_display",
      "type": "nominal",
      "title": "State",
      "sort": {
        "field": "average_state_inflation",
        "order": "descending"
      },
      "axis": {
        "labelLimit": 120
      }
    },
    "color": {
      "field": "inflation_yoy",
      "type": "quantitative",
      "title": "Year-on-year inflation (%)",
      "scale": {
        "domain": [
          -5,
          0,
          10
        ],
        "range": [
          "#2c7bb6",
          "#f7f7f7",
          "#b33a1c"
        ],
        "clamp": true
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 380
      }
    },
    "tooltip": [
      {
        "field": "state_display",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "division_name",
        "type": "nominal",
        "title": "Consumer Price Index division"
      },
      {
        "field": "month",
        "type": "nominal",
        "title": "Month"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "inflation_yoy",
        "type": "quantitative",
        "title": "Year-on-year inflation (%)",
        "format": ".1f"
      },
      {
        "field": "inflation_mom",
        "type": "quantitative",
        "title": "Month-on-month inflation (%)",
        "format": ".1f"
      },
      {
        "field": "pressure_group",
        "type": "nominal",
        "title": "Pressure group"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial, sans-serif",
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "grid": false,
      "domain": false,
      "tickColor": "#cccccc"
    },
    "legend": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif"
    }
  }
}