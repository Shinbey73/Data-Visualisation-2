{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "title":  {
                  "text":  "Where is food price pressure highest in Malaysia?",
                  "subtitle":  "Year-on-year inflation for food and non-alcoholic beverages by state",
                  "anchor":  "start",
                  "fontSize":  20,
                  "subtitleFontSize":  13,
                  "subtitleColor":  "#555",
                  "offset":  20
              },
    "width":  1050,
    "height":  600,
    "background":  "#ffffff",
    "params":  [
                   {
                       "name":  "selected_year",
                       "value":  2026,
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    2011,
                                                    2012,
                                                    2013,
                                                    2014,
                                                    2015,
                                                    2016,
                                                    2017,
                                                    2018,
                                                    2019,
                                                    2020,
                                                    2021,
                                                    2022,
                                                    2023,
                                                    2024,
                                                    2025,
                                                    2026
                                                ],
                                    "name":  "Year: "
                                }
                   },
                   {
                       "name":  "selected_month",
                       "value":  "March",
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    "January",
                                                    "February",
                                                    "March",
                                                    "April",
                                                    "May",
                                                    "June",
                                                    "July",
                                                    "August",
                                                    "September",
                                                    "October",
                                                    "November",
                                                    "December"
                                                ],
                                    "name":  "Month: "
                                }
                   }
               ],
    "projection":  {
                       "type":  "mercator",
                       "center":  [
                                      109.5,
                                      3.9
                                  ],
                       "scale":  1750
                   },
    "layer":  [
                  {
                      "data":  {
                                   "sphere":  true
                               },
                      "mark":  {
                                   "type":  "geoshape",
                                   "fill":  "#e8f4fb",
                                   "stroke":  null
                               }
                  },
                  {
                      "data":  {
                                   "url":  "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json",
                                   "format":  {
                                                  "type":  "topojson",
                                                  "feature":  "countries"
                                              }
                               },
                      "mark":  {
                                   "type":  "geoshape",
                                   "fill":  "#f4f0e7",
                                   "stroke":  "#d7d0c4",
                                   "strokeWidth":  0.5
                               }
                  },
                  {
                      "data":  {
                                   "values":  [
                                                  {
                                                      "label":  "Thailand",
                                                      "longitude":  101.2,
                                                      "latitude":  7.3,
                                                      "type":  "land"
                                                  },
                                                  {
                                                      "label":  "Indonesia",
                                                      "longitude":  112.3,
                                                      "latitude":  -1.0,
                                                      "type":  "land"
                                                  },
                                                  {
                                                      "label":  "South China Sea",
                                                      "longitude":  108.2,
                                                      "latitude":  6.3,
                                                      "type":  "water"
                                                  },
                                                  {
                                                      "label":  "Strait of Malacca",
                                                      "longitude":  100.3,
                                                      "latitude":  2.1,
                                                      "type":  "water"
                                                  }
                                              ]
                               },
                      "mark":  {
                                   "type":  "text",
                                   "fontSize":  14,
                                   "fontStyle":  "italic",
                                   "fontWeight":  700,
                                   "opacity":  0.9
                               },
                      "encoding":  {
                                       "longitude":  {
                                                         "field":  "longitude",
                                                         "type":  "quantitative"
                                                     },
                                       "latitude":  {
                                                        "field":  "latitude",
                                                        "type":  "quantitative"
                                                    },
                                       "text":  {
                                                    "field":  "label"
                                                },
                                       "color":  {
                                                     "field":  "type",
                                                     "type":  "nominal",
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "land",
                                                                                  "water"
                                                                              ],
                                                                   "range":  [
                                                                                 "#6f6658",
                                                                                 "#2f6f91"
                                                                             ]
                                                               },
                                                     "legend":  null
                                                 }
                                   }
                  },
                  {
                      "data":  {
                                   "url":  "data/cpi_food_state_inflation_clean.csv"
                               },
                      "transform":  [
                                        {
                                            "filter":  "datum.year == selected_year \u0026\u0026 datum.month == selected_month"
                                        },
                                        {
                                            "calculate":  "datum.map_state == 'Melaka' ? 'Malacca' : datum.map_state",
                                            "as":  "geo_state"
                                        },
                                        {
                                            "lookup":  "geo_state",
                                            "from":  {
                                                         "data":  {
                                                                      "url":  "https://media.githubusercontent.com/media/wmgeolab/geoBoundaries/9469f09/releaseData/gbOpen/MYS/ADM1/geoBoundaries-MYS-ADM1.topojson",
                                                                      "format":  {
                                                                                     "type":  "topojson",
                                                                                     "feature":  "MYSADM1gbOpen"
                                                                                 }
                                                                  },
                                                         "key":  "properties.shapeName"
                                                     },
                                            "as":  "geo"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "geoshape",
                                   "stroke":  "#ffffff",
                                   "strokeWidth":  1.1
                               },
                      "encoding":  {
                                       "shape":  {
                                                     "field":  "geo",
                                                     "type":  "geojson"
                                                 },
                                       "color":  {
                                                     "field":  "inflation_yoy",
                                                     "type":  "quantitative",
                                                     "title":  "Food inflation (%)",
                                                     "scale":  {
                                                                   "scheme":  "blues",
                                                                   "domain":  [
                                                                                  -2,
                                                                                  10
                                                                              ]
                                                               },
                                                     "legend":  null
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "state",
                                                           "type":  "nominal",
                                                           "title":  "State"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "month",
                                                           "type":  "nominal",
                                                           "title":  "Month"
                                                       },
                                                       {
                                                           "field":  "division_name",
                                                           "type":  "nominal",
                                                           "title":  "Division"
                                                       },
                                                       {
                                                           "field":  "inflation_yoy",
                                                           "type":  "quantitative",
                                                           "title":  "Year-on-year inflation (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "inflation_mom",
                                                           "type":  "quantitative",
                                                           "title":  "Month-on-month inflation (%)",
                                                           "format":  ".1f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "data":  {
                                   "url":  "https://media.githubusercontent.com/media/wmgeolab/geoBoundaries/9469f09/releaseData/gbOpen/MYS/ADM1/geoBoundaries-MYS-ADM1.topojson",
                                   "format":  {
                                                  "type":  "topojson",
                                                  "mesh":  "MYSADM1gbOpen"
                                              }
                               },
                      "mark":  {
                                   "type":  "geoshape",
                                   "fill":  null,
                                   "stroke":  "#ffffff",
                                   "strokeWidth":  0.8
                               }
                  }
              ],
    "config":  {
                   "view":  {
                                "stroke":  null
                            },
                   "font":  "Inter, Arial, sans-serif",
                   "axis":  {
                                "labelFontSize":  11,
                                "titleFontSize":  12
                            },
                   "legend":  {
                                  "labelFontSize":  11,
                                  "titleFontSize":  12
                              }
               }
}
