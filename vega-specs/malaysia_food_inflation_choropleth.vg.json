{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where is food price pressure highest in Malaysia?",
    "subtitle": "Year-on-year inflation for food and non-alcoholic beverages by state",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "width": 850,
  "height": 600,
  "background": "#ffffff",
  "params": [
    {
      "name": "selected_year",
      "value": 2026,
      "bind": {
        "input": "select",
        "options": [
          2011,
          2012,
          2013,
          2014,
          2015,
          2016,
          2017,
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024,
          2025,
          2026
        ],
        "name": "Year: "
      }
    },
    {
      "name": "selected_month",
      "value": "March",
      "bind": {
        "input": "select",
        "options": [
          "January",
          "February",
          "March",
          "April",
          "May",
          "June",
          "July",
          "August",
          "September",
          "October",
          "November",
          "December"
        ],
        "name": "Month: "
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [
      109.5,
      3.9
    ],
    "scale": 1750
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8f4fb",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f0e7",
        "stroke": "#d7d0c4",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/cpi_food_state_inflation_clean.csv"
      },
      "transform": [
        {
          "filter": "datum.year == selected_year && datum.month == selected_month"
        },
        {
          "lookup": "map_state",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/jnewbery/CartogramMalaysia/master/public/data/malaysia-states.topojson",
              "format": {
                "type": "topojson",
                "feature": "states"
              }
            },
            "key": "properties.Name"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.1
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "inflation_yoy",
          "type": "quantitative",
          "title": "Food inflation (%)",
          "scale": {
            "scheme": "orangered",
            "domain": [
              -2,
              10
            ]
          },
          "legend": {
            "orient": "right",
            "titleLimit": 160,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "gradientLength": 220
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "month",
            "type": "nominal",
            "title": "Month"
          },
          {
            "field": "division_name",
            "type": "nominal",
            "title": "Division"
          },
          {
            "field": "inflation_yoy",
            "type": "quantitative",
            "title": "Year-on-year inflation (%)",
            "format": ".1f"
          },
          {
            "field": "inflation_mom",
            "type": "quantitative",
            "title": "Month-on-month inflation (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jnewbery/CartogramMalaysia/master/public/data/malaysia-states.topojson",
        "format": {
          "type": "topojson",
          "mesh": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial, sans-serif",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}