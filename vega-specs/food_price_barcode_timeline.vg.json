{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "When did food inflation become more intense?",
    "subtitle": "Monthly year-on-year inflation for food and non-alcoholic beverages by Malaysian state",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555"
  },
  "width": 860,
  "height": 430,
  "data": {
    "url": "data/cpi_food_barcode_timeline_clean.csv"
  },
  "params": [
    {
      "name": "start_year",
      "value": 2020,
      "bind": {
        "input": "select",
        "options": [2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026],
        "name": "Start year: "
      }
    },
    {
      "name": "end_year",
      "value": 2026,
      "bind": {
        "input": "select",
        "options": [2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026],
        "name": "End year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year >= start_year && datum.year <= end_year"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "inflation_yoy",
          "as": "average_selected_food_inflation"
        }
      ],
      "groupby": ["state_display"]
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 0.15
  },
  "encoding": {
    "x": {
      "field": "year_month",
      "type": "ordinal",
      "sort": {
        "field": "date_number",
        "order": "ascending"
      },
      "title": "Month",
      "axis": {
        "labelAngle": 0,
        "labelExpr": "substring(datum.label, 5, 7) == '01' ? substring(datum.label, 0, 4) : ''",
        "labelPadding": 8,
        "tickSize": 0,
        "domain": false
      }
    },
    "y": {
      "field": "state_display",
      "type": "nominal",
      "title": "State",
      "sort": {
        "field": "average_selected_food_inflation",
        "order": "descending"
      },
      "axis": {
        "labelPadding": 6,
        "domain": false,
        "ticks": false
      }
    },
    "color": {
      "field": "inflation_yoy",
      "type": "quantitative",
      "title": "Food inflation (%)",
      "scale": {
        "domain": [-5, 0, 5, 10],
        "range": ["#4c78a8", "#f7f7f7", "#f58518", "#7b3294"],
        "clamp": true
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 260,
        "titleAnchor": "start"
      }
    },
    "tooltip": [
      {
        "field": "state_display",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "month",
        "type": "nominal",
        "title": "Month"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "division_name",
        "type": "nominal",
        "title": "Division"
      },
      {
        "field": "inflation_yoy",
        "type": "quantitative",
        "title": "Year-on-year inflation (%)",
        "format": ".1f"
      },
      {
        "field": "inflation_mom",
        "type": "quantitative",
        "title": "Month-on-month inflation (%)",
        "format": ".1f"
      },
      {
        "field": "pressure_level",
        "type": "nominal",
        "title": "Pressure level"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial, sans-serif",
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "grid": false,
      "labelColor": "#333333",
      "titleColor": "#333333"
    },
    "legend": {
      "titleFont": "Inter, Arial, sans-serif",
      "labelFont": "Inter, Arial, sans-serif"
    }
  }
}
