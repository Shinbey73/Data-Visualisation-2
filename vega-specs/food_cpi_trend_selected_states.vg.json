{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Consumer Price Index trend over time",
    "subtitle": "Selected Malaysian states, food and non-alcoholic beverages",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555"
  },
  "width": 780,
  "height": 430,
  "data": {
    "url": "data/cpi_food_selected_states_trend_clean.csv"
  },
  "params": [
    {
      "name": "start_year",
      "value": 2020,
      "bind": {
        "input": "select",
        "options": [
          2010,
          2011,
          2012,
          2013,
          2014,
          2015,
          2016,
          2017,
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024,
          2025,
          2026
        ],
        "name": "Start year: "
      }
    },
    {
      "name": "end_year",
      "value": 2026,
      "bind": {
        "input": "select",
        "options": [
          2010,
          2011,
          2012,
          2013,
          2014,
          2015,
          2016,
          2017,
          2018,
          2019,
          2020,
          2021,
          2022,
          2023,
          2024,
          2025,
          2026
        ],
        "name": "End year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year >= start_year && datum.year <= end_year"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 2.4
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Month",
          "axis": {
            "format": "%Y",
            "labelAngle": 0,
            "grid": false
          }
        },
        "y": {
          "field": "food_consumer_price_index",
          "type": "quantitative",
          "title": "Food Consumer Price Index",
          "scale": {
            "zero": false
          },
          "axis": {
            "grid": true
          }
        },
        "color": {
          "field": "state_display",
          "type": "nominal",
          "title": "State"
        },
        "tooltip": [
          {
            "field": "state_display",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "month",
            "type": "nominal",
            "title": "Month"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "division_name",
            "type": "nominal",
            "title": "Division"
          },
          {
            "field": "food_consumer_price_index",
            "type": "quantitative",
            "title": "Food Consumer Price Index",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "date_number",
              "as": "latest_date_number"
            }
          ],
          "groupby": [
            "state_display"
          ]
        },
        {
          "filter": "datum.date_number == datum.latest_date_number"
        },
        {
          "calculate": "datum.state_display + '  ' + format(datum.food_consumer_price_index, '.1f')",
          "as": "end_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "food_consumer_price_index",
          "type": "quantitative"
        },
        "color": {
          "field": "state_display",
          "type": "nominal",
          "legend": null
        },
        "text": {
          "field": "end_label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2020 && datum.month_number == 1"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "strokeWidth": 1,
        "color": "#777777",
        "opacity": 0.45
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2020 && datum.month_number == 1 && datum.state_display == 'Selangor'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 7,
        "dy": -8,
        "fontSize": 11,
        "color": "#555555"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "datum": 145
        },
        "text": {
          "value": "Default view begins in 2020"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, Arial, sans-serif",
    "axis": {
      "labelFont": "Inter, Arial, sans-serif",
      "titleFont": "Inter, Arial, sans-serif",
      "gridColor": "#eeeeee",
      "tickColor": "#cccccc",
      "domainColor": "#cccccc"
    },
    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "titleFont": "Inter, Arial, sans-serif",
      "labelFont": "Inter, Arial, sans-serif"
    }
  }
}