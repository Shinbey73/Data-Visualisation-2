    "transform":  [
                      {
                          "filter":  "datum.period_label == earlier_period || datum.period_label == later_period"
                      },
                      {
                          "calculate":  "datum.period_label == earlier_period ? \u0027Earlier period\u0027 : \u0027Later period\u0027",
                          "as":  "comparison_period"
                      },
                      {
                          "calculate":  "datum.period_label == earlier_period ? 0 : 1",
                          "as":  "comparison_order"
                      },
                      {
                          "window":  [
                                         {
                                             "op":  "first_value",
                                             "field":  "inflation_yoy",
                                             "as":  "earlier_inflation"
                                         },
                                         {
                                             "op":  "last_value",
                                             "field":  "inflation_yoy",
                                             "as":  "later_inflation"
                                         }
                                     ],
                          "groupby":  [
                                          "state_display"
                                      ],
                          "sort":  [
                                       {
                                           "field":  "comparison_order",
                                           "order":  "ascending"
                                       }
                                   ]
                      },
                      {
                          "calculate":  "datum.later_inflation - datum.earlier_inflation",
                          "as":  "change_in_inflation"
                      },
                      {
                          "joinaggregate":  [
                                                {
                                                    "op":  "max",
                                                    "field":  "change_in_inflation",
                                                    "as":  "largest_increase"
                                                },
                                                {
                                                    "op":  "min",
                                                    "field":  "change_in_inflation",
                                                    "as":  "largest_easing"
                                                }
                                            ]
                      },
                      {
                          "calculate":  "datum.change_in_inflation == datum.largest_increase ? \u0027Strongest increase\u0027 : datum.change_in_inflation == datum.largest_easing ? \u0027Strongest easing\u0027 : \u0027Other states\u0027",
                          "as":  "highlight_group"
                      },
                      {
                          "calculate":  "datum.change_in_inflation \u003e 0 ? \u0027+\u0027 + format(datum.change_in_inflation, \u0027.1f\u0027) + \u0027 percentage points\u0027 : format(datum.change_in_inflation, \u0027.1f\u0027) + \u0027 percentage points\u0027",
                          "as":  "change_label"
                      }
                  ],
