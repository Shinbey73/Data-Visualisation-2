{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "title":  {
                  "text":  "Urban versus rural food Consumer Price Index",
                  "subtitle":  "Monthly food and beverages Consumer Price Index by household strata",
                  "anchor":  "start",
                  "fontSize":  20,
                  "subtitleFontSize":  12,
                  "subtitleColor":  "#555555",
                  "offset":  20
              },
    "width":  780,
    "height":  420,
    "data":  {
                 "url":  "data/urban_rural_food_cpi_clean.csv"
             },
    "params":  [
                   {
                       "name":  "start_year",
                       "value":  2010,
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    2010,
                                                    2011,
                                                    2012,
                                                    2013,
                                                    2014,
                                                    2015,
                                                    2016,
                                                    2017,
                                                    2018,
                                                    2019,
                                                    2020,
                                                    2021,
                                                    2022,
                                                    2023,
                                                    2024,
                                                    2025,
                                                    2026
                                                ],
                                    "name":  "Start year: "
                                }
                   },
                   {
                       "name":  "end_year",
                       "value":  2026,
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    2010,
                                                    2011,
                                                    2012,
                                                    2013,
                                                    2014,
                                                    2015,
                                                    2016,
                                                    2017,
                                                    2018,
                                                    2019,
                                                    2020,
                                                    2021,
                                                    2022,
                                                    2023,
                                                    2024,
                                                    2025,
                                                    2026
                                                ],
                                    "name":  "End year: "
                                }
                   }
               ],
    "transform":  [
                      {
                          "filter":  "datum.year \u003e= start_year \u0026\u0026 datum.year \u003c= end_year"
                      }
                  ],
    "layer":  [
                  {
                      "mark":  {
                                   "type":  "line",
                                   "interpolate":  "monotone",
                                   "strokeWidth":  2.6
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal",
                                                 "title":  "Month",
                                                 "axis":  {
                                                              "format":  "%Y",
                                                              "labelAngle":  0,
                                                              "grid":  false
                                                          }
                                             },
                                       "y":  {
                                                 "field":  "food_consumer_price_index",
                                                 "type":  "quantitative",
                                                 "title":  "Food and beverages Consumer Price Index",
                                                 "scale":  {
                                                               "zero":  false
                                                           },
                                                 "axis":  {
                                                              "grid":  true
                                                          }
                                             },
                                       "color":  {
                                                     "field":  "strata_display",
                                                     "type":  "nominal",
                                                     "title":  "Household strata",
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "Urban households",
                                                                                  "Rural households"
                                                                              ],
                                                                   "range":  [
                                                                                 "#4c78a8",
                                                                                 "#f58518"
                                                                             ]
                                                               }
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "strata_display",
                                                           "type":  "nominal",
                                                           "title":  "Household strata"
                                                       },
                                                       {
                                                           "field":  "month",
                                                           "type":  "nominal",
                                                           "title":  "Month"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "division_name",
                                                           "type":  "nominal",
                                                           "title":  "Division"
                                                       },
                                                       {
                                                           "field":  "food_consumer_price_index",
                                                           "type":  "quantitative",
                                                           "title":  "Food and beverages Consumer Price Index",
                                                           "format":  ".1f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "joinaggregate":  [
                                                                  {
                                                                      "op":  "max",
                                                                      "field":  "date_number",
                                                                      "as":  "latest_date_number"
                                                                  }
                                                              ],
                                            "groupby":  [
                                                            "strata_display"
                                                        ]
                                        },
                                        {
                                            "filter":  "datum.date_number == datum.latest_date_number"
                                        },
                                        {
                                            "calculate":  "datum.strata_display + \u0027  \u0027 + format(datum.food_consumer_price_index, \u0027.1f\u0027)",
                                            "as":  "end_label"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "middle",
                                   "dx":  8,
                                   "fontSize":  11,
                                   "fontWeight":  "bold"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             },
                                       "y":  {
                                                 "field":  "food_consumer_price_index",
                                                 "type":  "quantitative"
                                             },
                                       "color":  {
                                                     "field":  "strata_display",
                                                     "type":  "nominal",
                                                     "legend":  null,
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "Urban households",
                                                                                  "Rural households"
                                                                              ],
                                                                   "range":  [
                                                                                 "#4c78a8",
                                                                                 "#f58518"
                                                                             ]
                                                               }
                                                 },
                                       "text":  {
                                                    "field":  "end_label"
                                                }
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  "datum.year == 2020 \u0026\u0026 datum.month_number == 1"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "rule",
                                   "strokeDash":  [
                                                      4,
                                                      4
                                                  ],
                                   "strokeWidth":  1,
                                   "color":  "#777777",
                                   "opacity":  0.45
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             }
                                   }
                  }
              ],
    "config":  {
                   "view":  {
                                "stroke":  null
                            },
                   "font":  "Inter, Arial, sans-serif",
                   "axis":  {
                                "labelFont":  "Inter, Arial, sans-serif",
                                "titleFont":  "Inter, Arial, sans-serif",
                                "gridColor":  "#eeeeee",
                                "tickColor":  "#cccccc",
                                "domainColor":  "#cccccc"
                            },
                   "legend":  {
                                  "orient":  "bottom",
                                  "direction":  "horizontal",
                                  "titleFont":  "Inter, Arial, sans-serif",
                                  "labelFont":  "Inter, Arial, sans-serif"
                              }
               }
}
