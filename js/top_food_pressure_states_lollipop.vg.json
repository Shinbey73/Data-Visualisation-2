{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "description":  "Ranked lollipop chart showing year-on-year food inflation by state with year and month filters.",
    "title":  {
                  "text":  "Ranked Food Pressure by State",
                  "subtitle":  "Year-on-year food inflation by state; the highlighted state marks the strongest pressure",
                  "anchor":  "start",
                  "fontSize":  20,
                  "subtitleFontSize":  13,
                  "offset":  20
              },
    "width":  "container",
    "height":  {
                   "step":  28
               },
    "autosize":  {
                     "type":  "fit-x",
                     "contains":  "padding",
                     "resize":  true
                 },
    "padding":  {
                    "left":  10,
                    "right":  20,
                    "top":  8,
                    "bottom":  8
                },
    "background":  "transparent",
    "params":  [
                   {
                       "name":  "selected_year",
                       "value":  2026,
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    2011,
                                                    2012,
                                                    2013,
                                                    2014,
                                                    2015,
                                                    2016,
                                                    2017,
                                                    2018,
                                                    2019,
                                                    2020,
                                                    2021,
                                                    2022,
                                                    2023,
                                                    2024,
                                                    2025,
                                                    2026
                                                ],
                                    "name":  "Year: "
                                }
                   },
                   {
                       "name":  "selected_month",
                       "value":  "March",
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    "January",
                                                    "February",
                                                    "March",
                                                    "April",
                                                    "May",
                                                    "June",
                                                    "July",
                                                    "August",
                                                    "September",
                                                    "October",
                                                    "November",
                                                    "December"
                                                ],
                                    "name":  "Month: "
                                }
                   }
               ],
    "data":  {
                 "url":  "data/cpi_food_state_pressure_ranked.csv"
             },
    "transform":  [
                      {
                          "filter":  "datum.division == \u002701\u0027 \u0026\u0026 datum.year == selected_year \u0026\u0026 datum.month == selected_month"
                      },
                      {
                          "window":  [
                                         {
                                             "op":  "rank",
                                             "as":  "rank"
                                         }
                                     ],
                          "sort":  [
                                       {
                                           "field":  "inflation_yoy",
                                           "order":  "descending"
                                       }
                                   ]
                      }
                  ],
    "layer":  [
                  {
                      "mark":  {
                                   "type":  "rule",
                                       "size":  2,
                                       "opacity":  0.75
                               },
                      "encoding":  {
                                       "y":  {
                                                 "field":  "state_display",
                                                 "type":  "ordinal",
                                                 "sort":  {
                                                              "field":  "rank",
                                                              "order":  "ascending"
                                                          },
                                                 "axis":  {
                                                              "title":  null,
                                                              "labelLimit":  300,
                                                              "labelFontSize":  12,
                                                              "labelFontWeight":  "bold",
                                                              "labelPadding":  8
                                                          }
                                             },
                                       "x":  {
                                                 "field":  "inflation_yoy",
                                                 "type":  "quantitative",
                                                 "axis":  {
                                                              "title":  "Year-on-year inflation (%)",
                                                              "grid":  true,
                                                              "gridColor":  "#e5e7eb",
                                                              "gridOpacity":  1,
                                                              "tickColor":  "#cbd5e1",
                                                              "domainColor":  "#94a3b8",
                                                              "labelColor":  "#334155",
                                                              "titleColor":  "#0f172a"
                                                          }
                                             },
                                       "x2":  {
                                                  "value":  0
                                              },
                                       "color":  {
                                                     "value":  "#cbd5e1"
                                                 }
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "point",
                                   "filled":  true,
                                   "size":  130,
                                   "opacity":  0.95,
                                   "stroke":  "#ffffff",
                                   "strokeWidth":  1.5
                               },
                      "encoding":  {
                                       "y":  {
                                                 "field":  "state_display",
                                                 "type":  "ordinal",
                                                 "sort":  {
                                                              "field":  "rank",
                                                              "order":  "ascending"
                                                          }
                                             },
                                       "x":  {
                                                 "field":  "inflation_yoy",
                                                 "type":  "quantitative"
                                             },
                                       "color":  {
                                                     "condition":  {
                                                                       "test":  "datum.rank === 1",
                                                                       "value":  "#b42318"
                                                                   },
                                                     "value":  "#64748b",
                                                     "legend":  null
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "state",
                                                           "type":  "nominal",
                                                           "title":  "State"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "month",
                                                           "type":  "nominal",
                                                           "title":  "Month"
                                                       },
                                                       {
                                                           "field":  "inflation_yoy",
                                                           "type":  "quantitative",
                                                          "title":  "Year-on-year inflation (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "inflation_mom",
                                                           "type":  "quantitative",
                                                          "title":  "Month-on-month inflation (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "rank",
                                                           "type":  "quantitative",
                                                           "title":  "Rank"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "text",
                                   "dx":  10,
                                   "align":  "left",
                                   "baseline":  "middle",
                                   "fontSize":  12,
                                   "fontWeight":  600
                               },
                      "encoding":  {
                                       "y":  {
                                                 "field":  "state_display",
                                                 "type":  "ordinal",
                                                 "sort":  {
                                                              "field":  "rank",
                                                              "order":  "ascending"
                                                          }
                                             },
                                       "x":  {
                                                 "field":  "inflation_yoy",
                                                 "type":  "quantitative"
                                             },
                                       "text":  {
                                                    "field":  "inflation_yoy",
                                                    "type":  "quantitative",
                                                    "format":  ".1f"
                                                },
                                       "color":  {
                                                     "condition":  {
                                                                       "test":  "datum.rank === 1",
                                                                       "value":  "#b42318"
                                                                   },
                                                     "value":  "#334155"
                                                 }
                                   }
                  }
              ],
    "config":  {
                   "axis":  {
                                "labelFontSize":  11,
                                "titleFontSize":  12,
                                "labelColor":  "#475569",
                                "titleColor":  "#0f172a"
                            },
                   "view":  {
                                "stroke":  null
                            },
                   "legend":  {
                                  "orient":  "right"
                              }
               }
}
