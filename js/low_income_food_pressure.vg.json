{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "title":  {
                  "text":  "Low-income household food pressure",
                  "subtitle":  "Food and beverages Consumer Price Index compared with all items for low-income households",
                  "anchor":  "start",
                  "fontSize":  20,
                  "subtitleFontSize":  12,
                  "subtitleColor":  "#555555",
                  "offset":  20
              },
    "width":  780,
    "height":  420,
    "data":  {
                 "url":  "data/low_income_food_pressure_clean.csv"
             },
    "params":  [
                   {
                       "name":  "start_year",
                       "value":  2010,
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    2010,
                                                    2011,
                                                    2012,
                                                    2013,
                                                    2014,
                                                    2015,
                                                    2016,
                                                    2017,
                                                    2018,
                                                    2019,
                                                    2020,
                                                    2021,
                                                    2022,
                                                    2023,
                                                    2024,
                                                    2025,
                                                    2026
                                                ],
                                    "name":  "Start year: "
                                }
                   },
                   {
                       "name":  "end_year",
                       "value":  2026,
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    2010,
                                                    2011,
                                                    2012,
                                                    2013,
                                                    2014,
                                                    2015,
                                                    2016,
                                                    2017,
                                                    2018,
                                                    2019,
                                                    2020,
                                                    2021,
                                                    2022,
                                                    2023,
                                                    2024,
                                                    2025,
                                                    2026
                                                ],
                                    "name":  "End year: "
                                }
                   }
               ],
    "transform":  [
                      {
                          "filter":  "datum.year \u003e= start_year \u0026\u0026 datum.year \u003c= end_year"
                      }
                  ],
    "layer":  [
                  {
                      "mark":  {
                                   "type":  "area",
                                   "opacity":  0.18,
                                   "color":  "#7b3294"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal",
                                                 "title":  "Month",
                                                 "axis":  {
                                                              "format":  "%Y",
                                                              "labelAngle":  0,
                                                              "grid":  false
                                                          }
                                             },
                                       "y":  {
                                                 "field":  "Low-income food and beverages",
                                                 "type":  "quantitative",
                                                 "title":  "Consumer Price Index",
                                                 "scale":  {
                                                               "zero":  false
                                                           }
                                             },
                                       "y2":  {
                                                  "field":  "Low-income all items"
                                              },
                                       "tooltip":  [
                                                       {
                                                           "field":  "month",
                                                           "type":  "nominal",
                                                           "title":  "Month"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "Low-income food and beverages",
                                                           "type":  "quantitative",
                                                           "title":  "Food and beverages Consumer Price Index",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "Low-income all items",
                                                           "type":  "quantitative",
                                                           "title":  "All items Consumer Price Index",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "food_pressure_gap",
                                                           "type":  "quantitative",
                                                           "title":  "Food pressure gap",
                                                           "format":  ".1f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "fold":  [
                                                         "Low-income all items",
                                                         "Low-income food and beverages"
                                                     ],
                                            "as":  [
                                                       "series_key",
                                                       "consumer_price_index"
                                                   ]
                                        },
                                        {
                                            "calculate":  "datum.series_key == \u0027Low-income food and beverages\u0027 ? \u0027Low-income food and beverages\u0027 : \u0027Low-income all items\u0027",
                                            "as":  "series_label"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "line",
                                   "strokeWidth":  2.6,
                                   "interpolate":  "monotone"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal",
                                                 "title":  "Month",
                                                 "axis":  {
                                                              "format":  "%Y",
                                                              "labelAngle":  0,
                                                              "grid":  false
                                                          }
                                             },
                                       "y":  {
                                                 "field":  "consumer_price_index",
                                                 "type":  "quantitative",
                                                 "title":  "Consumer Price Index",
                                                 "scale":  {
                                                               "zero":  false
                                                           }
                                             },
                                       "color":  {
                                                     "field":  "series_label",
                                                     "type":  "nominal",
                                                     "title":  null,
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "Low-income food and beverages",
                                                                                  "Low-income all items"
                                                                              ],
                                                                   "range":  [
                                                                                 "#7b3294",
                                                                                 "#666666"
                                                                             ]
                                                               }
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "series_label",
                                                           "type":  "nominal",
                                                           "title":  "Series"
                                                       },
                                                       {
                                                           "field":  "month",
                                                           "type":  "nominal",
                                                           "title":  "Month"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "consumer_price_index",
                                                           "type":  "quantitative",
                                                           "title":  "Consumer Price Index",
                                                           "format":  ".1f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "fold":  [
                                                         "Low-income all items",
                                                         "Low-income food and beverages"
                                                     ],
                                            "as":  [
                                                       "series_key",
                                                       "consumer_price_index"
                                                   ]
                                        },
                                        {
                                            "calculate":  "datum.series_key == \u0027Low-income food and beverages\u0027 ? \u0027Low-income food and beverages\u0027 : \u0027Low-income all items\u0027",
                                            "as":  "series_label"
                                        },
                                        {
                                            "joinaggregate":  [
                                                                  {
                                                                      "op":  "max",
                                                                      "field":  "date_number",
                                                                      "as":  "latest_selected_date_number"
                                                                  }
                                                              ]
                                        },
                                        {
                                            "filter":  "datum.date_number == datum.latest_selected_date_number"
                                        },
                                        {
                                            "calculate":  "datum.series_label + \u0027  \u0027 + format(datum.consumer_price_index, \u0027.1f\u0027)",
                                            "as":  "end_label"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "middle",
                                   "dx":  8,
                                   "fontSize":  11,
                                   "fontWeight":  "bold"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             },
                                       "y":  {
                                                 "field":  "consumer_price_index",
                                                 "type":  "quantitative"
                                             },
                                       "color":  {
                                                     "field":  "series_label",
                                                     "type":  "nominal",
                                                     "legend":  null,
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "Low-income food and beverages",
                                                                                  "Low-income all items"
                                                                              ],
                                                                   "range":  [
                                                                                 "#7b3294",
                                                                                 "#666666"
                                                                             ]
                                                               }
                                                 },
                                       "text":  {
                                                    "field":  "end_label"
                                                }
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "joinaggregate":  [
                                                                  {
                                                                      "op":  "max",
                                                                      "field":  "date_number",
                                                                      "as":  "latest_selected_date_number"
                                                                  }
                                                              ]
                                        },
                                        {
                                            "filter":  "datum.date_number == datum.latest_selected_date_number"
                                        },
                                        {
                                            "calculate":  "\u0027Food pressure gap: +\u0027 + format(datum.food_pressure_gap, \u0027.1f\u0027) + \u0027 index points\u0027",
                                            "as":  "gap_label"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "bottom",
                                   "dx":  8,
                                   "dy":  -16,
                                   "fontSize":  11,
                                   "fontWeight":  "bold",
                                   "color":  "#F59E0B"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             },
                                       "y":  {
                                                 "field":  "Low-income food and beverages",
                                                 "type":  "quantitative"
                                             },
                                       "text":  {
                                                    "field":  "gap_label"
                                                }
                                   }
                  }
              ],
    "config":  {
                   "view":  {
                                "stroke":  null
                            },
                   "font":  "Inter, Arial, sans-serif",
                   "axis":  {
                                "labelFont":  "Inter, Arial, sans-serif",
                                "titleFont":  "Inter, Arial, sans-serif",
                                "gridColor":  "#eeeeee",
                                "tickColor":  "#cccccc",
                                "domainColor":  "#cccccc"
                            },
                   "legend":  {
                                  "orient":  "bottom",
                                  "direction":  "horizontal",
                                  "labelFont":  "Inter, Arial, sans-serif"
                              }
               }
}
