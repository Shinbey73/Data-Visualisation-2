{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "title":  {
                  "text":  "Where is crop production concentrated?",
                  "subtitle":  "Crop production relative to the top state (%) by Malaysian state, with ocean and neighbouring countries for geographic context",
                  "anchor":  "start",
                  "fontSize":  20,
                  "subtitleFontSize":  12,
                  "subtitleColor":  "#555555",
                  "offset":  20
              },
    "width":  1050,
    "height":  520,
    "background":  "#ffffff",
    "params":  [
                   {
                       "name":  "selected_year",
                       "value":  2022,
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    2017,
                                                    2018,
                                                    2019,
                                                    2020,
                                                    2021,
                                                    2022
                                                ],
                                    "name":  "Year: "
                                }
                   },
                   {
                       "name":  "selected_crop",
                       "value":  "All food crops",
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    "All food crops",
                                                    "Paddy",
                                                    "Fruits",
                                                    "Vegetables",
                                                    "Coconut",
                                                    "Herbs",
                                                    "Spices"
                                                ],
                                    "name":  "Crop type: "
                                }
                   },
                   {
                       "name":  "map_zoom",
                       "value":  1750,
                       "bind":  {
                                    "input":  "range",
                                    "min":  1200,
                                    "max":  3200,
                                    "step":  50,
                                    "name":  "Map zoom: "
                                }
                   }
               ],
    "projection":  {
                       "type":  "mercator",
                       "center":  [
                                      109.5,
                                      3.9
                                  ],
                       "scale":  {
                                      "expr":  "map_zoom"
                                  }
                   },
    "layer":  [
                  {
                      "data":  {
                                   "sphere":  true
                               },
                      "mark":  {
                                   "type":  "geoshape",
                                   "fill":  "#e8f4fb",
                                   "stroke":  null
                               }
                  },
                  {
                      "data":  {
                                   "url":  "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json",
                                   "format":  {
                                                  "type":  "topojson",
                                                  "feature":  "countries"
                                              }
                               },
                      "mark":  {
                                   "type":  "geoshape",
                                   "fill":  "#f4f0e7",
                                   "stroke":  "#d7d0c4",
                                   "strokeWidth":  0.5
                               }
                  },
                  {
                      "data":  {
                                   "values":  [
                                                  {
                                                      "label":  "Thailand",
                                                      "longitude":  101.2,
                                                      "latitude":  7.3,
                                                      "type":  "land"
                                                  },
                                                  {
                                                      "label":  "Indonesia",
                                                      "longitude":  112.3,
                                                      "latitude":  -1.0,
                                                      "type":  "land"
                                                  },
                                                  {
                                                      "label":  "South China Sea",
                                                      "longitude":  108.2,
                                                      "latitude":  6.3,
                                                      "type":  "water"
                                                  },
                                                  {
                                                      "label":  "Strait of Malacca",
                                                      "longitude":  100.3,
                                                      "latitude":  2.1,
                                                      "type":  "water"
                                                  }
                                              ]
                               },
                      "mark":  {
                                   "type":  "text",
                                   "fontSize":  14,
                                   "fontStyle":  "italic",
                                   "fontWeight":  700,
                                   "opacity":  0.9
                               },
                      "encoding":  {
                                       "longitude":  {
                                                         "field":  "longitude",
                                                         "type":  "quantitative"
                                                     },
                                       "latitude":  {
                                                        "field":  "latitude",
                                                        "type":  "quantitative"
                                                    },
                                       "text":  {
                                                    "field":  "label"
                                                },
                                       "color":  {
                                                     "field":  "type",
                                                     "type":  "nominal",
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "land",
                                                                                  "water"
                                                                              ],
                                                                   "range":  [
                                                                                 "#6f6658",
                                                                                 "#2f6f91"
                                                                             ]
                                                               },
                                                     "legend":  null
                                                 }
                                   }
                  },
                  {
                      "data":  {
                                   "url":  "https://media.githubusercontent.com/media/wmgeolab/geoBoundaries/9469f09/releaseData/gbOpen/MYS/ADM1/geoBoundaries-MYS-ADM1.topojson",
                                   "format":  {
                                                  "type":  "topojson",
                                                  "feature":  "MYSADM1gbOpen"
                                              }
                               },
                      "mark":  {
                                   "type":  "geoshape",
                                   "fill":  "#eeeeee",
                                   "stroke":  "#ffffff",
                                   "strokeWidth":  0.8
                               }
                  },
                  {
                      "data":  {
                                   "url":  "data/crop_production_state_map_clean.csv",
                                   "format":  {
                                                  "type":  "csv"
                                              }
                               },
                      "transform":  [
                                        {
                                            "filter":  "datum.year == selected_year \u0026\u0026 datum.crop_group == selected_crop"
                                        },
                                        {
                                            "joinaggregate":  [
                                                                  {
                                                                      "op":  "max",
                                                                      "field":  "production",
                                                                      "as":  "max_selected_production"
                                                                  }
                                                              ]
                                        },
                                        {
                                            "calculate":  "datum.max_selected_production > 0 ? datum.production / datum.max_selected_production * 100 : 0",
                                            "as":  "normalised_production_index"
                                        },
                                        {
                                            "calculate":  "datum.map_state == 'Melaka' ? 'Malacca' : datum.map_state",
                                            "as":  "geo_state"
                                        },
                                        {
                                            "lookup":  "geo_state",
                                            "from":  {
                                                         "data":  {
                                                                      "url":  "https://media.githubusercontent.com/media/wmgeolab/geoBoundaries/9469f09/releaseData/gbOpen/MYS/ADM1/geoBoundaries-MYS-ADM1.topojson",
                                                                      "format":  {
                                                                                     "type":  "topojson",
                                                                                     "feature":  "MYSADM1gbOpen"
                                                                                 }
                                                                  },
                                                         "key":  "properties.shapeName"
                                                     },
                                            "as":  "geo"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "geoshape",
                                   "stroke":  "#ffffff",
                                   "strokeWidth":  1.1
                               },
                      "encoding":  {
                                       "shape":  {
                                                     "field":  "geo",
                                                     "type":  "geojson"
                                                 },
                                       "color":  {
                                                     "field":  "normalised_production_index",
                                                     "type":  "quantitative",
                                                     "title":  "Production relative to top state (%)",
                                                     "scale":  {
                                                                   "scheme":  "blues",
                                                                   "domain":  [
                                                                                  0,
                                                                                  100
                                                                              ]
                                                               },
                                                     "legend":  null
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "state_display",
                                                           "type":  "nominal",
                                                           "title":  "State"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "crop_group",
                                                           "type":  "nominal",
                                                           "title":  "Crop type"
                                                       },
                                                       {
                                                           "field":  "normalised_production_index",
                                                           "type":  "quantitative",
                                                           "title":  "Production relative to top state (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "production",
                                                           "type":  "quantitative",
                                                           "title":  "Production (metric tonnes)",
                                                           "format":  ",.0f"
                                                       },
                                                       {
                                                           "field":  "planted_area",
                                                           "type":  "quantitative",
                                                           "title":  "Planted area (hectares)",
                                                           "format":  ",.1f"
                                                       },
                                                       {
                                                           "field":  "production_share_percent",
                                                           "type":  "quantitative",
                                                           "title":  "Share of selected crop production (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "production_rank",
                                                           "type":  "ordinal",
                                                           "title":  "Production rank"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "data":  {
                                   "url":  "https://media.githubusercontent.com/media/wmgeolab/geoBoundaries/9469f09/releaseData/gbOpen/MYS/ADM1/geoBoundaries-MYS-ADM1.topojson",
                                   "format":  {
                                                  "type":  "topojson",
                                                  "mesh":  "MYSADM1gbOpen"
                                              }
                               },
                      "mark":  {
                                   "type":  "geoshape",
                                   "fill":  null,
                                   "stroke":  "#ffffff",
                                   "strokeWidth":  0.8
                               }
                  }
              ],
    "config":  {
                   "view":  {
                                "stroke":  null
                            },
                   "font":  "Inter, Arial, sans-serif",
                   "axis":  {
                                "labelFontSize":  11,
                                "titleFontSize":  12
                            },
                   "legend":  {
                                  "labelFontSize":  11,
                                  "titleFontSize":  12
                              }
               }
}
