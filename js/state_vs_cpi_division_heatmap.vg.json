{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "title":  {
                  "text":  "State versus food-related price pressure heatmap",
                  "subtitle":  "Blue cells show easing, pale cells sit near zero, and orange cells show stronger year-on-year inflation",
                  "anchor":  "start",
                  "fontSize":  20,
                  "subtitleFontSize":  12,
                  "subtitleColor":  "#555555",
                  "offset":  20
              },
    "width":  "container",
    "autosize":  {
                     "type":  "fit-x",
                     "contains":  "padding"
                 },
    "padding":  {
                    "left":  96,
                    "right":  36,
                    "top":  24,
                    "bottom":  112
                },
    "height":  440,
    "data":  {
                 "url":  "data/cpi_state_division_heatmap_clean.csv"
             },
    "params":  [
                   {
                       "name":  "selected_year",
                       "value":  2026,
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    2011,
                                                    2012,
                                                    2013,
                                                    2014,
                                                    2015,
                                                    2016,
                                                    2017,
                                                    2018,
                                                    2019,
                                                    2020,
                                                    2021,
                                                    2022,
                                                    2023,
                                                    2024,
                                                    2025,
                                                    2026
                                                ],
                                    "name":  "Year: "
                                }
                   },
                   {
                       "name":  "selected_month",
                       "value":  "March",
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    "January",
                                                    "February",
                                                    "March",
                                                    "April",
                                                    "May",
                                                    "June",
                                                    "July",
                                                    "August",
                                                    "September",
                                                    "October",
                                                    "November",
                                                    "December"
                                                ],
                                    "name":  "Month: "
                                }
                   },
                   {
                       "name":  "division_view",
                       "value":  "Food-related pressure channels",
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    "Food-related pressure channels",
                                                    "All main divisions"
                                                ],
                                    "name":  "Division view: "
                                }
                   }
               ],
    "transform":  [
                      {
                          "filter":  "datum.year == selected_year \u0026\u0026 datum.month == selected_month"
                      },
                      {
                          "filter":  "division_view == \u0027All main divisions\u0027 ? true : datum.division_scope == division_view"
                      },
                      {
                          "calculate":  "replace(replace(replace(replace(replace(replace(datum.division_label, \u0027Food and non-alcoholic beverages\u0027, \u0027Food & non-alc. beverages\u0027), \u0027Restaurants and accommodation services\u0027, \u0027Restaurants & accommodation\u0027), \u0027Personal care and miscellaneous services\u0027, \u0027Personal care & misc. services\u0027), \u0027Household equipment and maintenance\u0027, \u0027Household equipment\u0027), \u0027Insurance and financial services\u0027, \u0027Insurance & finance\u0027), \u0027Information and communication\u0027, \u0027Info & communication\u0027)",
                          "as":  "division_axis_label"
                      },
                      {
                          "joinaggregate":  [
                                                {
                                                    "op":  "mean",
                                                    "field":  "inflation_yoy",
                                                    "as":  "average_state_inflation"
                                                }
                                            ],
                          "groupby":  [
                                          "state_display"
                                      ]
                      }
                  ],
    "encoding":  {
                     "x":  {
                               "field":  "division_axis_label",
                               "type":  "nominal",
                               "title":  "CPI division",
                               "sort":  {
                                            "field":  "division_order",
                                            "order":  "ascending"
                                        },
                               "axis":  {
                                            "labelAngle":  -35,
                                            "labelLimit":  0,
                                            "labelFontSize":  10,
                                            "labelPadding":  8,
                                            "titlePadding":  28
                                        }
                           },
                     "y":  {
                               "field":  "state_display",
                               "type":  "nominal",
                               "title":  null,
                               "sort":  {
                                            "field":  "average_state_inflation",
                                            "order":  "descending"
                                        }
                           }
                 },
    "layer":  [
                  {
                      "mark":  {
                                   "type":  "rect",
                                   "stroke":  "#ffffff",
                                   "strokeWidth":  0.9
                               },
                      "encoding":  {
                                       "color":  {
                                                     "field":  "inflation_yoy",
                                                     "type":  "quantitative",
                                                     "title":  "Year-on-year inflation (%)",
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  -3,
                                                                                  0,
                                                                                  6
                                                                              ],
                                                                   "range":  [
                                                                                 "#2563a9",
                                                                                 "#f8fafc",
                                                                                 "#c2410c"
                                                                             ],
                                                                   "clamp":  true
                                                               },
                                                     "legend":  null
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "state",
                                                           "type":  "nominal",
                                                           "title":  "State"
                                                       },
                                                       {
                                                           "field":  "division_name",
                                                           "type":  "nominal",
                                                           "title":  "Division"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "month",
                                                           "type":  "nominal",
                                                           "title":  "Month"
                                                       },
                                                       {
                                                           "field":  "inflation_yoy",
                                                           "type":  "quantitative",
                                                          "title":  "Year-on-year inflation (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "inflation_mom",
                                                           "type":  "quantitative",
                                                          "title":  "Month-on-month inflation (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "pressure_group",
                                                           "type":  "nominal",
                                                           "title":  "Pressure group"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "text",
                                   "fontSize":  10,
                                   "fontWeight":  600
                               },
                      "encoding":  {
                                       "text":  {
                                                    "condition":  {
                                                                      "test":  "division_view == \u0027Food-related pressure channels\u0027 || abs(datum.inflation_yoy) >= 4",
                                                                      "field":  "inflation_yoy",
                                                                      "type":  "quantitative",
                                                                      "format":  ".1f"
                                                                  },
                                                    "value":  ""
                                                },
                                       "color":  {
                                                     "condition":  {
                                                                       "test":  "datum.inflation_yoy >= 4.5 || datum.inflation_yoy <= -2",
                                                                       "value":  "#ffffff"
                                                                   },
                                                     "value":  "#1f2937"
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "state",
                                                           "type":  "nominal",
                                                           "title":  "State"
                                                       },
                                                       {
                                                           "field":  "division_name",
                                                           "type":  "nominal",
                                                           "title":  "Division"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "month",
                                                           "type":  "nominal",
                                                           "title":  "Month"
                                                       },
                                                       {
                                                           "field":  "inflation_yoy",
                                                           "type":  "quantitative",
                                                          "title":  "Year-on-year inflation (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "inflation_mom",
                                                           "type":  "quantitative",
                                                          "title":  "Month-on-month inflation (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "pressure_group",
                                                           "type":  "nominal",
                                                           "title":  "Pressure group"
                                                       }
                                                   ]
                                   }
                  }
              ],
    "config":  {
                   "view":  {
                                "stroke":  null
                            },
                   "font":  "Inter, Arial, sans-serif",
                   "axis":  {
                                "labelFont":  "Inter, Arial, sans-serif",
                                "titleFont":  "Inter, Arial, sans-serif",
                                "labelFontSize":  11,
                                "titleFontSize":  12,
                                "grid":  false
                            },
                   "legend":  {
                                  "titleFont":  "Inter, Arial, sans-serif",
                                  "labelFont":  "Inter, Arial, sans-serif",
                                  "titleFontSize":  12,
                                  "labelFontSize":  11
                              }
               }
}
