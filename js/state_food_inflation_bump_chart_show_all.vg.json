                                                                              ],
                                                                   "range":  [
                                                                                 "#4e79a7",
                                                                                 "#f28e2b",
                                                                                 "#e15759",
                                                                                 "#76b7b2",
                                                                                 "#59a14f",
                                                                                 "#edc949",
                                                                                 "#af7aa1",
                                                                                 "#ff9da7",
                                                                                 "#9c755f",
                                                                                 "#bab0ab",
                                                                                 "#2f4b7c",
                                                                                 "#a05195",
                                                                                 "#d45087",
                                                                                 "#f95d6a",
                                                                                 "#665191",
                                                                                 "#ffa600"
                                                                             ]
                                                               },
                                                     "legend":  null
                                                }
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  "datum.year == end_year \u0026\u0026 datum.rank == 1"
                                        },
                                        {
                                            "calculate":  "\u0027Highest in \u0027 + datum.year + \u0027: \u0027 + datum.state_display",
                                            "as":  "top_label"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "align":  "right",
                                   "baseline":  "top",
                                   "dx":  -12,
                                   "dy":  12,
                                   "fontSize":  11,
                                   "fontWeight":  "bold",
                                   "color":  "#333333"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "value":  880
                                             },
                                       "y":  {
                                                 "value":  0
                                             },
                                       "text":  {
