                                                           "title":  "Rank"
                                                       },
                                                       {
                                                           "field":  "food_inflation_yoy_avg",
                                                           "type":  "quantitative",
                                                           "title":  "Average food inflation (%)",
                                                           "format":  ".1f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  "datum.state_display == selected_state"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "point",
                                   "filled":  true,
                                   "size":  80,
                                   "stroke":  "white",
                                   "strokeWidth":  1.2
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "year",
                                                 "type":  "ordinal"
                                             },
                                       "y":  {
                                                 "field":  "rank",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "domain":  [
                                                                              1,
                                                                              16
                                                                          ],
                                                               "reverse":  true
