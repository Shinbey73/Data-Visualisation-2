                                                                                 "#a05195",
                                                                                 "#d45087",
                                                                                 "#f95d6a",
                                                                                 "#665191",
                                                                                 "#ffa600"
                                                                             ]
                                                               },
                                                     "legend":  null
                                             },
                                       "tooltip":  [
                                                       {
                                                           "field":  "state_display",
                                                           "type":  "nominal",
                                                           "title":  "State"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "rank",
                                                           "type":  "ordinal",
                                                           "title":  "Rank"
                                                       },
                                                       {
                                                           "field":  "food_inflation_yoy_avg",
                                                           "type":  "quantitative",
                                                           "title":  "Average food inflation (%)",
                                                           "format":  ".1f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  "datum.state_display == selected_state \u0026\u0026 datum.year == end_year"
                                        },
                                        {
                                            "calculate":  "datum.state_display + \u0027: rank \u0027 + datum.rank",
                                            "as":  "end_label"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "middle",
                                   "dx":  10,
                                   "fontWeight":  "bold",
                                   "fontSize":  12
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "year",
                                                 "type":  "ordinal"
                                             },
                                       "y":  {
                                                 "field":  "rank",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "domain":  [
                                                                              1,
                                                                              16
                                                                          ],
