{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "Food security pressure profile by state",
        "subtitle": "Each strip ranks states by that indicator's relative exposure score. The orange bar marks the largest exposure within the strip.",
        "anchor": "start",
        "fontSize": 20,
        "subtitleFontSize": 12,
        "subtitleColor": "#555555",
        "offset": 20
    },
    "data": {
        "url": "data/food_security_pressure_profile_clean.csv"
    },
    "params": [
        {
            "name": "selected_year",
            "value": 2022,
            "bind": {
                "input": "select",
                "options": [
                    2018,
                    2019,
                    2020,
                    2021,
                    2022
                ],
                "name": "Year: "
            }
        }
    ],
    "transform": [
        {
            "filter": "datum.year == selected_year"
        },
        {
            "calculate": "toNumber(datum.exposure_score)",
            "as": "exposure_score_num"
        },
        {
            "calculate": "toNumber(datum.overall_exposure_score)",
            "as": "overall_exposure_score_num"
        },
        {
            "calculate": "toNumber(datum.indicator_order)",
            "as": "indicator_order_num"
        },
        {
            "calculate": "datum.indicator == 'Food inflation' ? 'Food inflation' : datum.indicator == 'Crop production per 1,000 residents' ? 'Crop capacity' : datum.indicator == 'Fish landings per 1,000 residents' ? 'Fish supply' : 'Demand pressure'",
            "as": "indicator_short"
        },
        {
            "joinaggregate": [
                {
                    "op": "max",
                    "field": "exposure_score_num",
                    "as": "max_indicator_exposure"
                }
            ],
            "groupby": [
                "indicator"
            ]
        },
        {
            "calculate": "datum.exposure_score_num == datum.max_indicator_exposure ? 'Largest exposure in this indicator' : 'Other states'",
            "as": "highlight_group"
        }
    ],
    "facet": {
        "row": {
            "field": "indicator_short",
            "type": "nominal",
            "title": null,
            "sort": {
                "field": "indicator_order_num",
                "order": "ascending"
            },
            "header": {
                "labelFontSize": 13,
                "labelFontWeight": "bold",
                "labelColor": "#0f172a",
                "labelAnchor": "middle",
                "labelOrient": "top",
                "labelAlign": "center",
                "labelPadding": 10
            }
        }
    },
    "spec": {
        "width": 900,
        "height": 205,
        "layer": [
            {
                "mark": {
                    "type": "bar",
                    "cornerRadiusEnd": 2,
                    "opacity": 0.18,
                    "color": "#bdbdbd"
                },
                "encoding": {
                    "y": {
                        "field": "state_display",
                        "type": "nominal",
                        "sort": {
                            "field": "exposure_score_num",
                            "order": "descending"
                        },
                        "title": null,
                        "axis": {
                            "labelFontSize": 11,
                            "labelLimit": 180
                        }
                    },
                    "x": {
                        "datum": 0,
                        "type": "quantitative",
                        "scale": {
                            "domain": [
                                0,
                                105
                            ]
                        },
                        "title": "Relative exposure score"
                    },
                    "x2": {
                        "datum": 100,
                        "type": "quantitative"
                    }
                }
            },
            {
                "mark": {
                    "type": "bar",
                    "cornerRadiusEnd": 2
                },
                "encoding": {
                    "y": {
                        "field": "state_display",
                        "type": "nominal",
                        "sort": {
                            "field": "exposure_score_num",
                            "order": "descending"
                        },
                        "title": null,
                        "axis": {
                            "labelFontSize": 11,
                            "labelLimit": 180
                        }
                    },
                    "x": {
                        "datum": 0,
                        "type": "quantitative",
                        "scale": {
                            "domain": [
                                0,
                                105
                            ]
                        },
                        "title": "Relative exposure score"
                    },
                    "x2": {
                        "field": "exposure_score_num",
                        "type": "quantitative"
                    },
                    "color": {
                        "condition": {
                            "test": "datum.highlight_group == 'Largest exposure in this indicator'",
                            "value": "#c2410c"
                        },
                        "value": "#94a3b8"
                    },
                    "tooltip": [
                        {
                            "field": "state_display",
                            "type": "nominal",
                            "title": "State"
                        },
                        {
                            "field": "year",
                            "type": "ordinal",
                            "title": "Year"
                        },
                        {
                            "field": "indicator",
                            "type": "nominal",
                            "title": "Indicator"
                        },
                        {
                            "field": "indicator_value_label",
                            "type": "nominal",
                            "title": "Original value"
                        },
                        {
                            "field": "exposure_score_num",
                            "type": "quantitative",
                            "title": "Relative exposure score",
                            "format": ".0f"
                        },
                        {
                            "field": "overall_exposure_score_num",
                            "type": "quantitative",
                            "title": "Overall average exposure score",
                            "format": ".0f"
                        },
                        {
                            "field": "indicator_meaning",
                            "type": "nominal",
                            "title": "Interpretation"
                        }
                    ]
                }
            },
            {
                "mark": {
                    "type": "text",
                    "align": "left",
                    "baseline": "middle",
                    "dx": 5,
                    "fontSize": 10,
                    "fontWeight": 700
                },
                "encoding": {
                    "y": {
                        "field": "state_display",
                        "type": "nominal",
                        "sort": {
                            "field": "exposure_score_num",
                            "order": "descending"
                        },
                        "title": null
                    },
                    "x": {
                        "field": "exposure_score_num",
                        "type": "quantitative",
                        "scale": {
                            "domain": [
                                0,
                                105
                            ]
                        }
                    },
                    "text": {
                        "field": "exposure_score_num",
                        "type": "quantitative",
                        "format": ".0f"
                    },
                    "color": {
                        "condition": {
                            "test": "datum.highlight_group == 'Largest exposure in this indicator'",
                            "value": "#9a3412"
                        },
                        "value": "#475569"
                    }
                }
            }
        ]
    },
    "resolve": {
        "scale": {
            "y": "independent"
        }
    },
    "config": {
        "view": {
            "stroke": null
        },
        "font": "Inter, Arial, sans-serif",
        "axis": {
            "labelFont": "Inter, Arial, sans-serif",
            "titleFont": "Inter, Arial, sans-serif",
            "grid": false,
            "tickColor": "#cccccc",
            "domainColor": "#cccccc"
        },
        "facet": {
            "spacing": 18
        }
    }
}
