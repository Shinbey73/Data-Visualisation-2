{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "title":  {
                  "text":  "Crop Production vs Food Inflation",
                  "subtitle":  "Each state compares selected crop production level with annual average food inflation",
                  "anchor":  "start",
                  "fontSize":  20,
                  "fontWeight":  700,
                  "subtitleFontSize":  12,
                  "subtitleColor":  "#64748b",
                  "offset":  18
              },
    "width":  "container",
    "height":  460,
    "autosize":  {
                     "type":  "fit-x",
                     "contains":  "padding",
                     "resize":  true
                 },
    "padding":  {
                    "left":  8,
                    "right":  28,
                    "top":  8,
                    "bottom":  10
                },
    "background":  "transparent",
    "data":  {
                 "url":  "data/crop_production_vs_food_inflation_clean.csv"
             },
    "params":  [
                   {
                       "name":  "selected_year",
                       "value":  2022,
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    2017,
                                                    2018,
                                                    2019,
                                                    2020,
                                                    2021,
                                                    2022
                                                ],
                                    "name":  "Year: "
                                }
                   },
                   {
                       "name":  "selected_crop",
                       "value":  "All food crops",
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    "All food crops",
                                                    "Paddy",
                                                    "Fruits",
                                                    "Vegetables",
                                                    "Coconut",
                                                    "Herbs",
                                                    "Spices"
                                                ],
                                    "name":  "Crop type: "
                                }
                   }
               ],
    "transform":  [
                      {
                          "filter":  "datum.year == selected_year && datum.crop_type_display == selected_crop && datum.production_tonnes > 0 && datum.planted_area_hectares > 0"
                      },
                      {
                          "joinaggregate":  [
                                                {
                                                    "op":  "median",
                                                    "field":  "production_share_percent",
                                                    "as":  "median_production_share"
                                                },
                                                {
                                                    "op":  "median",
                                                    "field":  "average_food_inflation",
                                                    "as":  "median_food_inflation"
                                                },
                                                {
                                                    "op":  "max",
                                                    "field":  "production_share_percent",
                                                    "as":  "highest_production_share"
                                                },
                                                {
                                                    "op":  "max",
                                                    "field":  "average_food_inflation",
                                                    "as":  "highest_inflation"
                                                }
                                            ]
                      },
                      {
                          "calculate":  "datum.production_share_percent >= datum.median_production_share && datum.average_food_inflation >= datum.median_food_inflation ? 'High production level, high inflation' : datum.production_share_percent >= datum.median_production_share && datum.average_food_inflation < datum.median_food_inflation ? 'High production level, lower inflation' : datum.production_share_percent < datum.median_production_share && datum.average_food_inflation >= datum.median_food_inflation ? 'Lower production level, high inflation' : 'Lower production level, lower inflation'",
                          "as":  "production_pressure_group"
                      },
                      {
                          "calculate":  "format(datum.production_thousand_tonnes, \u0027,.1f\u0027) + \u0027 thousand tonnes\u0027",
                          "as":  "production_label"
                      },
                      {
                          "calculate":  "format(datum.average_food_inflation, \u0027.1f\u0027) + \u0027%\u0027",
                          "as":  "inflation_label"
                      },
                      {
                          "calculate":  "datum.production_share_percent == datum.highest_production_share || datum.average_food_inflation == datum.highest_inflation || datum.production_pressure_group == 'High production level, high inflation' || datum.production_pressure_group == 'High production level, lower inflation'",
                          "as":  "show_label"
                      }
                  ],
    "layer":  [
                  {
                      "mark":  {
                                   "type":  "rule",
                                   "strokeDash":  [
                                                      4,
                                                      4
                                                  ],
                                   "color":  "#94a3b8",
                                   "strokeWidth":  1.2,
                                   "opacity":  0.85
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "median_production_share",
                                                 "type":  "quantitative"
                                             }
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "rule",
                                   "strokeDash":  [
                                                      4,
                                                      4
                                                  ],
                                   "color":  "#94a3b8",
                                   "strokeWidth":  1.2,
                                   "opacity":  0.85
                               },
                      "encoding":  {
                                       "y":  {
                                                 "field":  "median_food_inflation",
                                                 "type":  "quantitative"
                                             }
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "point",
                                   "filled":  true,
                                   "opacity":  0.9,
                                   "stroke":  "#ffffff",
                                   "strokeWidth":  1.8
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "production_share_percent",
                                                 "type":  "quantitative",
                                                 "title":  "Selected crop production level (%)",
                                                 "scale":  {
                                                               "zero":  true
                                                           },
                                                 "axis":  {
                                                              "format":  ".0f",
                                                              "grid":  true,
                                                              "gridColor":  "#edf2f7",
                                                              "gridOpacity":  1,
                                                              "tickColor":  "#cbd5e1",
                                                              "domainColor":  "#94a3b8",
                                                              "labelColor":  "#475569",
                                                              "titleColor":  "#0f172a",
                                                              "titleFontWeight":  700,
                                                              "titlePadding":  12
                                                          }
                                             },
                                       "y":  {
                                                 "field":  "average_food_inflation",
                                                 "type":  "quantitative",
                                                 "title":  "Average food inflation (%)",
                                                 "scale":  {
                                                               "zero":  false
                                                           },
                                                 "axis":  {
                                                              "grid":  true,
                                                              "gridColor":  "#edf2f7",
                                                              "gridOpacity":  1,
                                                              "tickColor":  "#cbd5e1",
                                                              "domainColor":  "#94a3b8",
                                                              "labelColor":  "#475569",
                                                              "titleColor":  "#0f172a",
                                                              "titleFontWeight":  700,
                                                              "titlePadding":  12
                                                          }
                                             },
                                       "size":  {
                                                    "field":  "planted_area_hectares",
                                                    "type":  "quantitative",
                                                    "title":  "Planted area (hectares)",
                                                    "scale":  {
                                                                  "range":  [
                                                                                70,
                                                                                620
                                                                            ]
                                                              },
                                                    "legend":  null
                                                },
                                       "color":  {
                                                     "field":  "production_pressure_group",
                                                     "type":  "nominal",
                                                     "title":  null,
                                                     "legend":  null,
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "High production level, high inflation",
                                                                                  "High production level, lower inflation",
                                                                                  "Lower production level, high inflation",
                                                                                  "Lower production level, lower inflation"
                                                                              ],
                                                                   "range":  [
                                                                                 "#7c3aed",
                                                                                 "#2563eb",
                                                                                 "#f97316",
                                                                                 "#0891b2"
                                                                             ]
                                                               }
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "state_display",
                                                           "type":  "nominal",
                                                           "title":  "State"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "crop_type_display",
                                                           "type":  "nominal",
                                                           "title":  "Crop type"
                                                       },
                                                       {
                                                           "field":  "production_tonnes",
                                                           "type":  "quantitative",
                                                           "title":  "Production (metric tonnes)",
                                                           "format":  ",.0f"
                                                       },
                                                       {
                                                           "field":  "planted_area_hectares",
                                                           "type":  "quantitative",
                                                           "title":  "Planted area (hectares)",
                                                           "format":  ",.0f"
                                                       },
                                                       {
                                                           "field":  "production_share_percent",
                                                           "type":  "quantitative",
                                                           "title":  "Share of selected production (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "average_food_inflation",
                                                           "type":  "quantitative",
                                                           "title":  "Average food inflation (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "months_available",
                                                           "type":  "quantitative",
                                                           "title":  "Inflation months averaged"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  "datum.show_label"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "middle",
                                   "dx":  13,
                                   "fontSize":  12,
                                   "fontWeight":  700
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "production_share_percent",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "zero":  true
                                                           }
                                             },
                                       "y":  {
                                                 "field":  "average_food_inflation",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "zero":  false
                                                           }
                                             },
                                       "text":  {
                                                    "field":  "state_display"
                                                },
                                       "color":  {
                                                     "field":  "production_pressure_group",
                                                     "type":  "nominal",
                                                     "legend":  null,
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "High production level, high inflation",
                                                                                  "High production level, lower inflation",
                                                                                  "Lower production level, high inflation",
                                                                                  "Lower production level, lower inflation"
                                                                              ],
                                                                   "range":  [
                                                                                 "#5b21b6",
                                                                                 "#1d4ed8",
                                                                                 "#9a3412",
                                                                                 "#0e7490"
                                                                             ]
                                                               }
                                                 }
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "top",
                                   "dx":  8,
                                   "dy":  8,
                                   "fontSize":  11,
                                   "fontWeight":  600,
                                   "color":  "#64748b"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "median_production_share",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "zero":  true
                                                           }
                                             },
                                       "y":  {
                                                 "field":  "median_food_inflation",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "zero":  false
                                                           }
                                             },
                                       "text":  {
                                                    "value":  "Median split"
                                                }
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "aggregate":  [
                                                              {
                                                                  "op":  "max",
                                                                  "field":  "production_share_percent",
                                                                  "as":  "max_production_share"
                                                              },
                                                              {
                                                                  "op":  "max",
                                                                  "field":  "average_food_inflation",
                                                                  "as":  "max_food_inflation"
                                                              }
                                                          ]
                                        },
                                        {
                                            "calculate":  "datum.max_production_share * 0.98",
                                            "as":  "quadrant_x"
                                        },
                                        {
                                            "calculate":  "datum.max_food_inflation * 0.98",
                                            "as":  "quadrant_y"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "align":  "right",
                                   "baseline":  "top",
                                   "fontSize":  11,
                                   "fontWeight":  700,
                                   "color":  "#7c3aed"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "quadrant_x",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "zero":  true
                                                           }
                                             },
                                       "y":  {
                                                 "field":  "quadrant_y",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "zero":  false
                                                           }
                                             }

                                   }
                  }
              ],
    "config":  {
                   "view":  {
                                "stroke":  null
                            },
                   "font":  "Inter, Arial, sans-serif",
                   "axis":  {
                                "labelFont":  "Inter, Arial, sans-serif",
                                "titleFont":  "Inter, Arial, sans-serif",
                                "labelFontSize":  11,
                                "titleFontSize":  12,
                                "gridColor":  "#edf2f7",
                                "tickColor":  "#cbd5e1",
                                "domainColor":  "#94a3b8"
                            },
                   "legend":  {
                                  "labelFont":  "Inter, Arial, sans-serif",
                                  "titleFont":  "Inter, Arial, sans-serif"
                              }
               }
}
