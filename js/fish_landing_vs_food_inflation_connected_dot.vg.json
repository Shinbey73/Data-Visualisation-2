{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "title":  {
                  "text":  "Fish landings versus food inflation",
                  "subtitle":  "Rank comparison by state; rank 1 means the highest value among states",
                  "anchor":  "start",
                  "fontSize":  20,
                  "subtitleFontSize":  12,
                  "subtitleColor":  "#555555",
                  "offset":  20
              },
    "width":  780,
    "height":  470,
    "data":  {
                 "url":  "data/fish_landing_vs_food_inflation_clean.csv"
             },
    "params":  [
                   {
                       "name":  "selected_year",
                       "value":  2023,
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    2018,
                                                    2019,
                                                    2020,
                                                    2021,
                                                    2022,
                                                    2023
                                                ],
                                    "name":  "Year: "
                                }
                   }
               ],
    "transform":  [
                      {
                          "filter":  "datum.year == selected_year"
                      },
                      {
                          "calculate":  "datum.pattern_group == \u0027High landing and high inflation\u0027 ? \u0027Important overlap\u0027 : \u0027Other states\u0027",
                          "as":  "highlight_group"
                      }
                  ],
    "layer":  [
                  {
                      "mark":  {
                                   "type":  "rule",
                                   "strokeWidth":  1.6,
                                   "stroke":  "#bdbdbd",
                                   "opacity":  0.75
                               },
                      "encoding":  {
                                       "y":  {
                                                 "field":  "state_display",
                                                 "type":  "nominal",
                                                 "title":  "State",
                                                 "sort":  {
                                                              "field":  "fish_landing_rank",
                                                              "order":  "ascending"
                                                          },
                                                 "axis":  {
                                                              "labelFontSize":  11,
                                                              "titlePadding":  10
                                                          }
                                             },
                                       "x":  {
                                                 "field":  "fish_landing_rank",
                                                 "type":  "quantitative",
                                                 "title":  "Rank among states",
                                                 "scale":  {
                                                               "domain":  [
                                                                              1,
                                                                              14
                                                                          ]
                                                           },
                                                 "axis":  {
                                                              "tickMinStep":  1,
                                                              "labelAngle":  0,
                                                              "titlePadding":  10
                                                          }
                                             },
                                       "x2":  {
                                                  "field":  "food_inflation_rank"
                                              },
                                       "tooltip":  [
                                                       {
                                                           "field":  "state_display",
                                                           "type":  "nominal",
                                                           "title":  "State"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "fish_landings_tonnes",
                                                           "type":  "quantitative",
                                                           "title":  "Fish landings (tonnes)",
                                                           "format":  ",.0f"
                                                       },
                                                       {
                                                           "field":  "fish_landing_rank",
                                                           "type":  "ordinal",
                                                           "title":  "Fish landing rank"
                                                       },
                                                       {
                                                           "field":  "average_food_inflation_yoy",
                                                           "type":  "quantitative",
                                                           "title":  "Average food inflation (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "food_inflation_rank",
                                                           "type":  "ordinal",
                                                           "title":  "Food inflation rank"
                                                       },
                                                       {
                                                           "field":  "pattern_group",
                                                           "type":  "nominal",
                                                           "title":  "Pattern"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "point",
                                   "filled":  true,
                                   "size":  85,
                                   "stroke":  "white",
                                   "strokeWidth":  1.1
                               },
                      "encoding":  {
                                       "y":  {
                                                 "field":  "state_display",
                                                 "type":  "nominal",
                                                 "sort":  {
                                                              "field":  "fish_landing_rank",
                                                              "order":  "ascending"
                                                          },
                                                 "title":  null
                                             },
                                       "x":  {
                                                 "field":  "fish_landing_rank",
                                                 "type":  "quantitative"
                                             },
                                       "color":  {
                                                     "value":  "#2c7bb6"
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "state_display",
                                                           "type":  "nominal",
                                                           "title":  "State"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "fish_landings_tonnes",
                                                           "type":  "quantitative",
                                                           "title":  "Fish landings (tonnes)",
                                                           "format":  ",.0f"
                                                       },
                                                       {
                                                           "field":  "fish_landing_rank",
                                                           "type":  "ordinal",
                                                           "title":  "Fish landing rank"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "point",
                                   "filled":  true,
                                   "size":  85,
                                   "stroke":  "white",
                                   "strokeWidth":  1.1
                               },
                      "encoding":  {
                                       "y":  {
                                                 "field":  "state_display",
                                                 "type":  "nominal",
                                                 "sort":  {
                                                              "field":  "fish_landing_rank",
                                                              "order":  "ascending"
                                                          },
                                                 "title":  null
                                             },
                                       "x":  {
                                                 "field":  "food_inflation_rank",
                                                 "type":  "quantitative"
                                             },
                                       "color":  {
                                                     "condition":  {
                                                                       "test":  "datum.highlight_group == \u0027Important overlap\u0027",
                                                                       "value":  "#7b3294"
                                                                   },
                                                     "value":  "#fdae61"
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "state_display",
                                                           "type":  "nominal",
                                                           "title":  "State"
                                                       },
                                                       {
                                                           "field":  "year",
                                                           "type":  "ordinal",
                                                           "title":  "Year"
                                                       },
                                                       {
                                                           "field":  "average_food_inflation_yoy",
                                                           "type":  "quantitative",
                                                           "title":  "Average food inflation (%)",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "food_inflation_rank",
                                                           "type":  "ordinal",
                                                           "title":  "Food inflation rank"
                                                       },
                                                       {
                                                           "field":  "pattern_group",
                                                           "type":  "nominal",
                                                           "title":  "Pattern"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "middle",
                                   "dx":  8,
                                   "fontSize":  10,
                                   "color":  "#2c7bb6",
                                   "fontWeight":  "bold"
                               },
                      "encoding":  {
                                       "y":  {
                                                 "field":  "state_display",
                                                 "type":  "nominal",
                                                 "sort":  {
                                                              "field":  "fish_landing_rank",
                                                              "order":  "ascending"
                                                          },
                                                 "title":  null
                                             },
                                       "x":  {
                                                 "field":  "fish_landing_rank",
                                                 "type":  "quantitative"
                                             },
                                       "text":  {
                                                    "value":  "Fish"
                                                }
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "middle",
                                   "dx":  8,
                                   "fontSize":  10,
                                   "fontWeight":  "bold"
                               },
                      "encoding":  {
                                       "y":  {
                                                 "field":  "state_display",
                                                 "type":  "nominal",
                                                 "sort":  {
                                                              "field":  "fish_landing_rank",
                                                              "order":  "ascending"
                                                          },
                                                 "title":  null
                                             },
                                       "x":  {
                                                 "field":  "food_inflation_rank",
                                                 "type":  "quantitative"
                                             },
                                       "text":  {
                                                    "value":  "Inflation"
                                                },
                                       "color":  {
                                                     "condition":  {
                                                                       "test":  "datum.highlight_group == \u0027Important overlap\u0027",
                                                                       "value":  "#8f2d16"
                                                                   },
                                                     "value":  "#9a5f00"
                                                 }
                                   }
                  }
              ],
    "config":  {
                   "view":  {
                                "stroke":  null
                            },
                   "font":  "Inter, Arial, sans-serif",
                   "axis":  {
                                "labelFont":  "Inter, Arial, sans-serif",
                                "titleFont":  "Inter, Arial, sans-serif",
                                "gridColor":  "#eeeeee",
                                "tickColor":  "#cccccc",
                                "domainColor":  "#cccccc"
                            }
               }
}
