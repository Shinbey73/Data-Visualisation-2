{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected dot plot comparing fish landing rank and food inflation rank by Malaysian state.",
  "title": {
    "text": "Fish Landings vs Food Inflation Rank",
    "subtitle": "Rank 1 means highest among states; shorter connectors show closer agreement between production and price pressure",
    "anchor": "start",
    "fontSize": 20,
    "fontWeight": 700,
    "subtitleFontSize": 12,
    "subtitleColor": "#64748b",
    "offset": 18
  },
  "width": "container",
  "height": {
    "step": 30
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 8,
    "right": 24,
    "top": 8,
    "bottom": 8
  },
  "background": "transparent",
  "data": {
    "url": "data/fish_landing_vs_food_inflation_clean.csv"
  },
  "params": [
    {
      "name": "selected_year",
      "value": 2023,
      "bind": {
        "input": "select",
        "options": [
          2018,
          2019,
          2020,
          2021,
          2022,
          2023
        ],
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year == selected_year"
    },
    {
      "calculate": "datum.pattern_group == 'High landing and high inflation' ? 'Important overlap' : 'Other states'",
      "as": "highlight_group"
    },
    {
      "calculate": "abs(datum.fish_landing_rank - datum.food_inflation_rank)",
      "as": "rank_gap"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#e2e8f0",
        "strokeWidth": 1,
        "opacity": 0.65
      },
      "encoding": {
        "y": {
          "field": "state_display",
          "type": "nominal",
          "sort": {
            "field": "fish_landing_rank",
            "order": "ascending"
          },
          "axis": {
            "title": null,
            "labelFontSize": 11,
            "labelFontWeight": 600,
            "labelColor": "#334155",
            "labelPadding": 8,
            "labelLimit": 220,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "value": 0
        },
        "x2": {
          "value": 14
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "fish_landing_rank",
            "food_inflation_rank"
          ],
          "as": [
            "rank_type",
            "rank_value"
          ]
        },
        {
          "calculate": "datum.rank_type == 'fish_landing_rank' ? 1 : 2",
          "as": "rank_order"
        }
      ],
      "mark": {
        "type": "line",
        "strokeCap": "round",
        "opacity": 0.9
      },
      "encoding": {
        "y": {
          "field": "state_display",
          "type": "nominal",
          "sort": {
            "field": "fish_landing_rank",
            "order": "ascending"
          }
        },
        "x": {
          "field": "rank_value",
          "type": "quantitative",
          "title": "Rank among states",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false
          },
          "axis": {
            "orient": "bottom",
            "tickMinStep": 1,
            "labelAngle": 0,
            "grid": true,
            "gridColor": "#e5e7eb",
            "gridOpacity": 1,
            "tickColor": "#cbd5e1",
            "domainColor": "#94a3b8",
            "labelColor": "#475569",
            "titleColor": "#0f172a",
            "titlePadding": 10
          }
        },
        "detail": {
          "field": "state_display"
        },
        "order": {
          "field": "rank_order"
        },
        "color": {
          "value": "#cbd5e1"
        },
        "size": {
          "condition": {
            "test": "datum.highlight_group == 'Important overlap'",
            "value": 3
          },
          "value": 1.8
        },
        "tooltip": [
          {
            "field": "state_display",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "fish_landings_tonnes",
            "type": "quantitative",
            "title": "Fish landings (tonnes)",
            "format": ",.0f"
          },
          {
            "field": "fish_landing_rank",
            "type": "ordinal",
            "title": "Fish landing rank"
          },
          {
            "field": "average_food_inflation_yoy",
            "type": "quantitative",
            "title": "Average food inflation (%)",
            "format": ".1f"
          },
          {
            "field": "food_inflation_rank",
            "type": "ordinal",
            "title": "Food inflation rank"
          },
          {
            "field": "rank_gap",
            "type": "quantitative",
            "title": "Rank gap"
          },
          {
            "field": "pattern_group",
            "type": "nominal",
            "title": "Pattern"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "fish_landing_rank",
            "food_inflation_rank"
          ],
          "as": [
            "rank_type",
            "rank_value"
          ]
        },
        {
          "calculate": "datum.rank_type == 'fish_landing_rank' ? 'Fish landings' : 'Food inflation'",
          "as": "metric"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "circle",
        "size": 120,
        "stroke": "#ffffff",
        "strokeWidth": 1.6,
        "opacity": 0.98
      },
      "encoding": {
        "y": {
          "field": "state_display",
          "type": "nominal",
          "sort": {
            "field": "fish_landing_rank",
            "order": "ascending"
          }
        },
        "x": {
          "field": "rank_value",
          "type": "quantitative"
        },
        "color": {
          "field": "metric",
          "type": "nominal",
          "scale": {
            "domain": [
              "Fish landings",
              "Food inflation"
            ],
            "range": [
              "#0f766e",
              "#ea580c"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state_display",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "metric",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "rank_value",
            "type": "ordinal",
            "title": "Rank"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "fish_landings_tonnes",
            "type": "quantitative",
            "title": "Fish landings (tonnes)",
            "format": ",.0f"
          },
          {
            "field": "average_food_inflation_yoy",
            "type": "quantitative",
            "title": "Average food inflation (%)",
            "format": ".1f"
          },
          {
            "field": "rank_gap",
            "type": "quantitative",
            "title": "Rank gap"
          },
          {
            "field": "pattern_group",
            "type": "nominal",
            "title": "Pattern"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "fish_landing_rank",
            "food_inflation_rank"
          ],
          "as": [
            "rank_type",
            "rank_value"
          ]
        },
        {
          "calculate": "datum.rank_type == 'fish_landing_rank' ? 'Fish landings' : 'Food inflation'",
          "as": "metric"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 10,
        "fontWeight": 700
      },
      "encoding": {
        "y": {
          "field": "state_display",
          "type": "nominal",
          "sort": {
            "field": "fish_landing_rank",
            "order": "ascending"
          }
        },
        "x": {
          "field": "rank_value",
          "type": "quantitative"
        },
        "text": {
          "field": "rank_value",
          "type": "quantitative"
        },
        "color": {
          "field": "metric",
          "type": "nominal",
          "scale": {
            "domain": [
              "Fish landings",
              "Food inflation"
            ],
            "range": [
              "#0f766e",
              "#ea580c"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "font": "Inter, Segoe UI, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter, Segoe UI, Arial, sans-serif",
      "titleFont": "Inter, Segoe UI, Arial, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#334155",
      "symbolStrokeWidth": 0
    }
  }
}
