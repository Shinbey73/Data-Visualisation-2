{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "title":  {
                  "text":  "Selected Food Basket Price Index",
                  "subtitle":  "Daily median basket price in May 2026. Index starts at 100 on the first available day for the selected area.",
                  "anchor":  "start",
                  "fontSize":  20,
                  "subtitleFontSize":  12,
                  "subtitleColor":  "#555555",
                  "offset":  20
              },
    "width":  760,
    "height":  360,
    "data":  {
                 "url":  "data/food_basket_price_index_clean.csv"
             },
    "params":  [
                   {
                       "name":  "selected_area",
                       "value":  "Malaysia overall",
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    "Malaysia overall",
                                                    "Johor",
                                                    "Kedah",
                                                    "Kelantan",
                                                    "Melaka",
                                                    "Negeri Sembilan",
                                                    "Pahang",
                                                    "Perak",
                                                    "Perlis",
                                                    "Pulau Pinang",
                                                    "Sabah",
                                                    "Selangor",
                                                    "Terengganu",
                                                    "W.P. Kuala Lumpur",
                                                    "W.P. Labuan",
                                                    "W.P. Putrajaya"
                                                ],
                                    "name":  "Area: "
                                }
                   }
               ],
    "transform":  [
                      {
                          "filter":  "datum.area == selected_area"
                      }
                  ],
    "layer":  [
                  {
                      "mark":  {
                                   "type":  "rule",
                                   "strokeDash":  [
                                                      4,
                                                      4
                                                  ],
                                   "strokeWidth":  1,
                                   "color":  "#777777",
                                   "opacity":  0.45
                               },
                      "encoding":  {
                                       "y":  {
                                                 "datum":  100,
                                                 "type":  "quantitative"
                                             }
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "line",
                                   "strokeWidth":  2.6,
                                   "interpolate":  "monotone",
                                   "color":  "#4c4c4c"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal",
                                                 "title":  "Date",
                                                 "axis":  {
                                                              "format":  "%d %b",
                                                              "labelAngle":  0,
                                                              "grid":  false
                                                          }
                                             },
                                       "y":  {
                                                 "field":  "basket_index",
                                                 "type":  "quantitative",
                                                 "title":  "Food basket price index",
                                                 "scale":  {
                                                               "zero":  false
                                                           },
                                                 "axis":  {
                                                              "grid":  true
                                                          }
                                             },
                                       "tooltip":  [
                                                       {
                                                           "field":  "area",
                                                           "type":  "nominal",
                                                           "title":  "Area"
                                                       },
                                                       {
                                                           "field":  "date",
                                                           "type":  "temporal",
                                                           "title":  "Date",
                                                           "format":  "%d %B %Y"
                                                       },
                                                       {
                                                           "field":  "basket_index",
                                                           "type":  "quantitative",
                                                           "title":  "Basket price index",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "basket_price",
                                                           "type":  "quantitative",
                                                           "title":  "Basket price (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "base_date",
                                                           "type":  "nominal",
                                                           "title":  "Base date"
                                                       },
                                                       {
                                                           "field":  "base_basket_price",
                                                           "type":  "quantitative",
                                                           "title":  "Base basket price (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "chicken_standard_price",
                                                           "type":  "quantitative",
                                                           "title":  "Chicken, standard (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "eggs_grade_a_price",
                                                           "type":  "quantitative",
                                                           "title":  "Eggs, grade A (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "kembung_fish_price",
                                                           "type":  "quantitative",
                                                           "title":  "Kembung fish (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "tomato_price",
                                                           "type":  "quantitative",
                                                           "title":  "Tomato (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "yellow_onion_price",
                                                           "type":  "quantitative",
                                                           "title":  "Yellow onion (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "potato_price",
                                                           "type":  "quantitative",
                                                           "title":  "Potato (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "water_spinach_price",
                                                           "type":  "quantitative",
                                                           "title":  "Water spinach (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "red_chili_kulai_price",
                                                           "type":  "quantitative",
                                                           "title":  "Red chili, Kulai (RM)",
                                                           "format":  ".2f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "point",
                                   "filled":  true,
                                   "size":  45,
                                   "color":  "#4c4c4c",
                                   "opacity":  0.55
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             },
                                       "y":  {
                                                 "field":  "basket_index",
                                                 "type":  "quantitative"
                                             }
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  "datum.highlight_point != \u0027Normal day\u0027"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "point",
                                   "filled":  true,
                                   "size":  115,
                                   "stroke":  "white",
                                   "strokeWidth":  1.2
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             },
                                       "y":  {
                                                 "field":  "basket_index",
                                                 "type":  "quantitative"
                                             },
                                       "color":  {
                                                     "field":  "highlight_point",
                                                     "type":  "nominal",
                                                     "title":  null,
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "Highest basket index",
                                                                                  "Lowest basket index"
                                                                              ],
                                                                   "range":  [
                                                                                 "#7b3294",
                                                                                 "#2c7bb6"
                                                                             ]
                                                               },
                                                     "legend":  {
                                                                    "orient":  "bottom",
                                                                    "direction":  "horizontal"
                                                                }
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "highlight_point",
                                                           "type":  "nominal",
                                                           "title":  "Point"
                                                       },
                                                       {
                                                           "field":  "area",
                                                           "type":  "nominal",
                                                           "title":  "Area"
                                                       },
                                                       {
                                                           "field":  "date",
                                                           "type":  "temporal",
                                                           "title":  "Date",
                                                           "format":  "%d %B %Y"
                                                       },
                                                       {
                                                           "field":  "basket_index",
                                                           "type":  "quantitative",
                                                           "title":  "Basket price index",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "basket_price",
                                                           "type":  "quantitative",
                                                           "title":  "Basket price (RM)",
                                                           "format":  ".2f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  "datum.highlight_point != \u0027Normal day\u0027"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "dy":  -12,
                                   "fontSize":  11,
                                   "fontWeight":  "bold"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             },
                                       "y":  {
                                                 "field":  "basket_index",
                                                 "type":  "quantitative"
                                             },
                                       "text":  {
                                                    "field":  "basket_index_label"
                                                },
                                       "color":  {
                                                     "field":  "highlight_point",
                                                     "type":  "nominal",
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "Highest basket index",
                                                                                  "Lowest basket index"
                                                                              ],
                                                                   "range":  [
                                                                                 "#7b3294",
                                                                                 "#2c7bb6"
                                                                             ]
                                                               },
                                                     "legend":  null
                                                 }
                                   }
                  }
              ],
    "config":  {
                   "view":  {
                                "stroke":  null
                            },
                   "font":  "Inter, Arial, sans-serif",
                   "axis":  {
                                "labelFont":  "Inter, Arial, sans-serif",
                                "titleFont":  "Inter, Arial, sans-serif",
                                "gridColor":  "#eeeeee",
                                "tickColor":  "#cccccc",
                                "domainColor":  "#cccccc"
                            },
                   "legend":  {
                                  "labelFont":  "Inter, Arial, sans-serif",
                                  "titleFont":  "Inter, Arial, sans-serif"
                              }
               }
}
