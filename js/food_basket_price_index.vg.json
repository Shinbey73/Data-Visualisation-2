{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "title":  {
                  "text":  "Selected Food Basket Price Index",
                  "subtitle":  "Daily median basket price in May 2026. Index starts at 100 on the first available day for the selected area.",
                  "anchor":  "start",
                  "fontSize":  20,
                  "subtitleFontSize":  12,
                  "subtitleColor":  "#64748b",
                  "offset":  20
              },
    "width":  980,
    "height":  560,
    "data":  {
                 "url":  "data/food_basket_price_index_clean.csv"
             },
    "params":  [
                   {
                       "name":  "selected_area",
                       "value":  "Malaysia overall",
                       "bind":  {
                                    "input":  "select",
                                    "options":  [
                                                    "Malaysia overall",
                                                    "Johor",
                                                    "Kedah",
                                                    "Kelantan",
                                                    "Melaka",
                                                    "Negeri Sembilan",
                                                    "Pahang",
                                                    "Perak",
                                                    "Perlis",
                                                    "Pulau Pinang",
                                                    "Sabah",
                                                    "Selangor",
                                                    "Terengganu",
                                                    "W.P. Kuala Lumpur",
                                                    "W.P. Labuan",
                                                    "W.P. Putrajaya"
                                                ],
                                    "name":  "Area: "
                                }
                   }
               ],
    "transform":  [
                      {
                          "filter":  "datum.area == selected_area"
                      },
                      {
                          "calculate":  "'Chicken, eggs, kembung fish, tomato, yellow onion, potato, water spinach, and red chili'",
                          "as":  "basket_items_label"
                      }
                  ],
    "layer":  [
                  {
                      "mark":  {
                                   "type":  "rule",
                                   "strokeDash":  [
                                                      4,
                                                      4
                                                  ],
                                   "strokeWidth":  1,
                                   "color":  "#94a3b8",
                                   "opacity":  0.75
                               },
                      "encoding":  {
                                       "y":  {
                                                 "datum":  100,
                                                 "type":  "quantitative"
                                             }
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "line",
                                   "strokeWidth":  3,
                                   "interpolate":  "monotone",
                                   "color":  "#7e1313",
                                   "opacity":  0.95,
                                   "strokeCap":  "round",
                                   "strokeJoin":  "round"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal",
                                                 "title":  "Day in May 2026",
                                                 "axis":  {
                                                              "format":  "%d %b",
                                                              "labelAngle":  0,
                                                              "grid":  false,
                                                              "labelColor":  "#64748b",
                                                              "titleColor":  "#334155"
                                                          }
                                             },
                                       "y":  {
                                                 "field":  "basket_index",
                                                 "type":  "quantitative",
                                                 "title":  "Food basket price index (base = 100)",
                                                 "scale":  {
                                                               "zero":  true
                                                           },
                                                 "axis":  {
                                                              "grid":  true,
                                                              "gridColor":  "#e5e7eb",
                                                              "labelColor":  "#64748b",
                                                              "titleColor":  "#334155",
                                                              "format":  ".1f"
                                                          }
                                             },
                                       "tooltip":  [
                                                       {
                                                           "field":  "area",
                                                           "type":  "nominal",
                                                           "title":  "Area"
                                                       },
                                                       {
                                                           "field":  "date",
                                                           "type":  "temporal",
                                                           "title":  "Date",
                                                           "format":  "%d %B %Y"
                                                       },
                                                       {
                                                           "field":  "basket_index",
                                                           "type":  "quantitative",
                                                           "title":  "Basket price index",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "basket_price",
                                                           "type":  "quantitative",
                                                           "title":  "Basket price (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "base_date",
                                                           "type":  "nominal",
                                                           "title":  "Base date"
                                                       },
                                                       {
                                                           "field":  "basket_items_label",
                                                           "type":  "nominal",
                                                           "title":  "Basket items"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "mark":  {
                                   "type":  "point",
                                   "filled":  true,
                                   "size":  52,
                                   "color":  "#7e1313",
                                   "opacity":  0.7
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             },
                                       "y":  {
                                                 "field":  "basket_index",
                                                 "type":  "quantitative"
                                             },
                                       "tooltip":  [
                                                       {
                                                           "field":  "area",
                                                           "type":  "nominal",
                                                           "title":  "Area"
                                                       },
                                                       {
                                                           "field":  "date",
                                                           "type":  "temporal",
                                                           "title":  "Date",
                                                           "format":  "%d %B %Y"
                                                       },
                                                       {
                                                           "field":  "basket_index",
                                                           "type":  "quantitative",
                                                           "title":  "Basket price index",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "basket_price",
                                                           "type":  "quantitative",
                                                           "title":  "Basket price (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "highlight_point",
                                                           "type":  "nominal",
                                                           "title":  "Point"
                                                       },
                                                       {
                                                           "field":  "basket_items_label",
                                                           "type":  "nominal",
                                                           "title":  "Basket items"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "joinaggregate":  [
                                                                  {
                                                                      "op":  "max",
                                                                      "field":  "date_number",
                                                                      "as":  "latest_date_number"
                                                                  }
                                                              ]
                                        },
                                        {
                                            "filter":  "datum.date_number == datum.latest_date_number"
                                        },
                                        {
                                            "calculate":  "\u0027Latest: \u0027 + format(datum.basket_index, \u0027.1f\u0027)",
                                            "as":  "latest_label"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "middle",
                                   "dx":  10,
                                   "fontSize":  11,
                                   "fontWeight":  "bold",
                                   "color":  "#7e1313"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             },
                                       "y":  {
                                                 "field":  "basket_index",
                                                 "type":  "quantitative"
                                             },
                                       "text":  {
                                                    "field":  "latest_label"
                                                }
                                   }
                  },
                  {
                      "data":  {
                                   "values":  [
                                                  {
                                                      "date":  "2026-05-04",
                                                      "basket_index":  36,
                                                      "annotation":  [
                                                                         "The basket index tracks chicken, eggs, fish, tomato, onion, potato, water spinach, and red chili.",
                                                                         "It is set to 100 on the first available day.",
                                                                         "Values above 100 mean the basket became more expensive than the base day."
                                                                     ]
                                                  }
                                              ]
                               },
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "top",
                                   "dx":  0,
                                   "dy":  0,
                                   "fontSize":  12,
                                   "fontWeight":  600,
                                   "color":  "#475569",
                                   "lineBreak":  "\n",
                                   "lineHeight":  16
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             },
                                       "y":  {
                                                 "field":  "basket_index",
                                                 "type":  "quantitative"
                                             },
                                       "text":  {
                                                    "field":  "annotation",
                                                    "type":  "nominal"
                                                }
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  "datum.highlight_point != \u0027Normal day\u0027"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "point",
                                   "filled":  true,
                                   "size":  115,
                                   "stroke":  "white",
                                   "strokeWidth":  1.2
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "date",
                                                 "type":  "temporal"
                                             },
                                       "y":  {
                                                 "field":  "basket_index",
                                                 "type":  "quantitative"
                                             },
                                       "color":  {
                                                     "field":  "highlight_point",
                                                     "type":  "nominal",
                                                     "title":  null,
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "Highest basket index",
                                                                                  "Lowest basket index"
                                                                              ],
                                                                   "range":  [
                                                                                 "#7b3294",
                                                                                 "#2c7bb6"
                                                                             ]
                                                               },
                                                     "legend":  null
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "highlight_point",
                                                           "type":  "nominal",
                                                           "title":  "Point"
                                                       },
                                                       {
                                                           "field":  "area",
                                                           "type":  "nominal",
                                                           "title":  "Area"
                                                       },
                                                       {
                                                           "field":  "date",
                                                           "type":  "temporal",
                                                           "title":  "Date",
                                                           "format":  "%d %B %Y"
                                                       },
                                                       {
                                                           "field":  "basket_index",
                                                           "type":  "quantitative",
                                                           "title":  "Basket price index",
                                                           "format":  ".1f"
                                                       },
                                                       {
                                                           "field":  "basket_price",
                                                           "type":  "quantitative",
                                                           "title":  "Basket price (RM)",
                                                           "format":  ".2f"
                                                       },
                                                       {
                                                           "field":  "basket_items_label",
                                                           "type":  "nominal",
                                                           "title":  "Basket items"
                                                       }
                                                   ]
                                   }
                  }
              ],
    "config":  {
                   "view":  {
                                "stroke":  null
                            },
                   "font":  "Inter, Arial, sans-serif",
                   "axis":  {
                                "labelFont":  "Inter, Arial, sans-serif",
                                "titleFont":  "Inter, Arial, sans-serif",
                                "gridColor":  "#eeeeee",
                                "tickColor":  "#cccccc",
                                "domainColor":  "#cccccc"
                            },
                   "legend":  {
                                  "labelFont":  "Inter, Arial, sans-serif",
                                  "titleFont":  "Inter, Arial, sans-serif"
                              }
               }
}
